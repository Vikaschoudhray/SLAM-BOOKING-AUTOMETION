# CRIS SLAM Jobcard Automation Configuration
# Never commit real credentials or bot tokens to source control.

# SLAM Portal Credentials
SLAM_USERNAME=your_slam_username_here
SLAM_PASSWORD=your_slam_password_here

# Telegram Bot API settings
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=-your_telegram_chat_id_here

# Automation Safety Controls
DRY_RUN=true
ENABLE_ACKNOWLEDGEMENT=false

# Portal and Browser Configuration
PORTAL_URL=https://slam.indianrail.gov.in/SLAM/Login.aspx
DASHBOARD_URL=https://slam.indianrail.gov.in/SLAM/JobSchedules/SectionJobCardsDashboard.aspx
CHROME_PROFILE_DIR=C:\RailwayBot\slam_chrome_profile
HEADLESS=false
BROWSER_TIMEOUT_MS=60000
LOGIN_WAIT_TIMEOUT_SECONDS=180
